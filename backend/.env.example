# Server Configuration
PORT=3000
NODE_ENV=production
DB_PATH=/app/data/mikrotik-qris.db

# Midtrans Payment Gateway Configuration
# Get your Server Key and Client Key from https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key-here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key-here
# Set to 'true' for production, 'false' for sandbox
MIDTRANS_IS_PRODUCTION=false

# MikroTik RouterOS Configuration (RouterOS v7 REST API)
# IP address or domain name of your MikroTik router (e.g. 192.168.88.1)
MIKROTIK_HOST=192.168.88.1
# REST API port (default: 80 for HTTP, 443 for HTTPS)
MIKROTIK_PORT=80
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_password
MIKROTIK_USE_HTTPS=false
# Default hotspot user profile to assign to purchased vouchers
MIKROTIK_DEFAULT_PROFILE=default
